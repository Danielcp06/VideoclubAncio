<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.Main">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Videoclub Ancio - Gestión de Películas" />

    <HBox alignment="CENTER_LEFT" spacing="10">

        <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="Buscar por nombre..." />

        <Button onAction="#onBuscar" styleClass="button-buscar" text="🔍 Buscar" />

        <Button onAction="#onActualizar" text="🔄 Actualizar" />

        <Region HBox.hgrow="ALWAYS" />

        <Button onAction="#onOpenAdd" style="-fx-background-color: #2e7d32; -fx-text-fill: white;" text="+ Añadir" />
        <Button onAction="#onEliminar" style="-fx-background-color: #d32f2f; -fx-text-fill: white;" text="🗑 Eliminar" />
    </HBox>

    <TableView fx:id="tablePeliculas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" prefWidth="250" text="Nombre" />
            <TableColumn fx:id="colAño" prefWidth="100" text="Año" />
            <TableColumn fx:id="colGenero" prefWidth="100" text="Género" />
         <TableColumn fx:id="colPrecio1" prefWidth="100" text="Precio" />
        </columns>
    </TableView>
</VBox>
